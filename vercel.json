{
  "redirects": [
    {
      "source": "/our-product",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/our-prices",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/seo-pricing",
      "destination": "/services/seo-aeo/",
      "permanent": true
    },
    {
      "source": "/seo-why",
      "destination": "/services/seo-aeo/",
      "permanent": true
    },
    {
      "source": "/stepone",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/payments",
      "destination": "/coraline/",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-of-service/",
      "permanent": true
    },
    {
      "source": "/bnioffer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bniprofile",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/formsubmissioncomplete-websiteinfoform",
      "destination": "/form-completion/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/copy-of-websitebuildinfo",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://*.msgsndr.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://*.leadconnectorhq.com https://*.msgsndr.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com https://*.leadconnectorhq.com https://*.msgsndr.com; connect-src 'self' https://*.leadconnectorhq.com https://*.msgsndr.com; frame-src https://*.leadconnectorhq.com https://*.msgsndr.com; media-src 'self' https:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
